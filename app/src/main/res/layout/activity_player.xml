<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.tvplayer.app.viewmodel.PlayerViewModel" />
    </data>

    <FrameLayout
        android:id="@+id/playerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        tools:context=".ui.player.PlayerActivity">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:shutter_background_color="@android:color/black" />

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/standbyPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            app:use_controller="false"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:shutter_background_color="@android:color/black" />

        <LinearLayout
            android:id="@+id/cornerOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="16dp"
            android:background="#66000000"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">
            <TextView
                android:id="@+id/currentTimeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="21:08" />
            <TextView
                android:id="@+id/versionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                tools:text="5xingTV 2.9.124" />
        </LinearLayout>

        <!-- Control Panel -->
        <LinearLayout
            android:id="@+id/controlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="#CC000000"
            android:padding="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Previous channel" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_next"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Next channel" />

            <ImageButton
                android:id="@+id/stopButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Stop" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/channelInfoButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Channel info" />

            <ImageButton
                android:id="@+id/qualityButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_upload"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Quality" />

            <ImageButton
                android:id="@+id/audioButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Audio" />

            <ImageButton
                android:id="@+id/subtitleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_edit"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Subtitles" />

            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_fullscreen"
                android:background="@drawable/tv_icon_button_background"
                android:contentDescription="Fullscreen" />

        </LinearLayout>

        <!-- Info Panel -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:background="#CC000000"
            android:padding="16dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/channelLogo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter"
                tools:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/channelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Channel Name" />

                <TextView
                    android:id="@+id/channelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="Channel Group" />

                <TextView
                    android:id="@+id/channelSourceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#90CAF9"
                    android:textSize="13sp"
                    tools:text="来源：Migu Video · 120ms · 1920x1080" />

                <TextView
                    android:id="@+id/epgNowText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="正在播：新闻联播 19:00-19:30" />

                <TextView
                    android:id="@+id/epgNextText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    tools:text="下一档：天气预报 19:30-19:35" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceSwitchContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/previousSourceButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tv_icon_button_background"
                    android:contentDescription="上一来源"
                    android:src="@android:drawable/ic_media_previous" />

                <TextView
                    android:id="@+id/sourceCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    tools:text="1/3" />

                <ImageButton
                    android:id="@+id/nextSourceButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/tv_icon_button_background"
                    android:contentDescription="下一来源"
                    android:src="@android:drawable/ic_media_next" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/currentChannelNameBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="28dp"
            android:layout_marginTop="24dp"
            android:background="#B3000000"
            android:ellipsize="end"
            android:maxWidth="700dp"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="当前频道名称" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bufferingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:background="#99000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="正在缓冲..."
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="72dp"
            android:background="#C0101010"
            android:maxWidth="820dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="虎牙解析失败：房间页请求失败，可能与 DNS / IPv6 / TLS 兼容有关" />

        <!--
            Remote interaction contract:
            - OK opens this left channel drawer.
            - MENU / BACK / long OK opens the bottom quick-action dock below.
            The two surfaces are mutually exclusive, so a remote user never
            has to guess which pane currently owns the D-pad.
        -->
        <LinearLayout
            android:id="@+id/channelListView"
            android:layout_width="470dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#F20B141C"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/groupPane"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:background="#332E4555"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/groupPaneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:text="分类"
                    android:textColor="#FF9FC3D6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#3358CFF4" />

            <LinearLayout
                android:id="@+id/channelPane"
                android:layout_width="270dp"
                android:layout_height="match_parent"
                android:background="#26182733"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/channelPaneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:text="频道 · OK 播放"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/channelRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />
            </LinearLayout>

            <View
                android:id="@+id/channelEpgDivider"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#3358CFF4" />

            <LinearLayout
                android:id="@+id/channelDrawerEpgPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="#26182733"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="频道节目单"
                    android:textColor="#FF9FC3D6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channelDrawerEpgChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingBottom="16dp"
                    android:text="选择频道查看节目单"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正在播"
                    android:textColor="#FF62D9FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channelDrawerEpgNowText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:text="暂无节目单"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="#3358CFF4" />

                <TextView
                    android:id="@+id/channelDrawerEpgScheduleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="后续节目"
                    android:textColor="#FF62D9FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channelDrawerEpgNextText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="7"
                    android:ellipsize="end"
                    android:text="暂无节目单"
                    android:textColor="#FFCCDDFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/channelDrawerEpgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:textColor="#FF9AAAB5"
                    android:textSize="12sp"
                    tools:text="节目单来自本机缓存" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom quick-action dock. MENU / BACK / long OK opens this dock. -->
        <LinearLayout
            android:id="@+id/actionMenuView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#F20B141C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/actionMenuTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快捷操作"
                    android:textColor="#FF9FC3D6"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/actionMenuCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFD580"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="20分后退出" />
            </LinearLayout>

            <Button
                android:id="@+id/quickPreviousButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="上一频道"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/quickPlayPauseButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="播放 / 暂停"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/quickNextButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="下一频道"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/quickSourceButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="切换来源"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/quickFavoriteButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="收藏"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/quickRemarkButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="备注"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/openSettingsMenuButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:background="@drawable/tv_action_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="设置"
                android:textColor="@color/tv_button_text" />

        </LinearLayout>

    </FrameLayout>
</layout>
