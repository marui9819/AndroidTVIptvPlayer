<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF164768" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="#FF62D9FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FF0D3654" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FF62D9FF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#334F6170" />
        </shape>
    </item>
</selector>
